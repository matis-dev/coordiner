{
  "name": "coordiner",
  "displayName": "Coordiner",
  "version": "0.2.0",
  "publisher": "matis-dev",
  "description": "Drives the m-skills story flow through headless Claude Code sessions, up to the commit brief.",
  "license": "MIT",
  "author": {
    "name": "Mateusz Kruszona"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/matis-dev/coordiner.git"
  },
  "homepage": "https://github.com/matis-dev/coordiner#readme",
  "bugs": {
    "url": "https://github.com/matis-dev/coordiner/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "m-skills",
    "ai",
    "agent",
    "worktree",
    "workflow"
  ],
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "node": ">=24",
    "vscode": "^1.135.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Coordiner runs Claude sessions and git commands in the open folder."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "coordiner.checkEnvironment",
        "title": "Coordiner: Check Environment"
      },
      {
        "command": "coordiner.runStory",
        "title": "Coordiner: Run Story…"
      },
      {
        "command": "coordiner.start",
        "title": "Coordiner: Start…",
        "icon": "$(play)"
      },
      {
        "command": "coordiner.openChains",
        "title": "Coordiner: Open Chains",
        "icon": "$(list-ordered)"
      },
      {
        "command": "coordiner.stopRun",
        "title": "Coordiner: Stop Run",
        "icon": "$(debug-stop)"
      },
      {
        "command": "coordiner.stopProcess",
        "title": "Stop Process",
        "icon": "$(debug-stop)"
      },
      {
        "command": "coordiner.openSession",
        "title": "Coordiner: Open Session"
      },
      {
        "command": "coordiner.continueWorktree",
        "title": "Continue",
        "icon": "$(debug-continue)"
      },
      {
        "command": "coordiner.startHere",
        "title": "Start a Chain Here",
        "icon": "$(play)"
      },
      {
        "command": "coordiner.openWorktree",
        "title": "Open in New Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "coordiner.removeWorktree",
        "title": "Remove Worktree…",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "coordiner.stopProcess",
          "when": "false"
        },
        {
          "command": "coordiner.openSession",
          "when": "false"
        },
        {
          "command": "coordiner.continueWorktree",
          "when": "false"
        },
        {
          "command": "coordiner.startHere",
          "when": "false"
        },
        {
          "command": "coordiner.openWorktree",
          "when": "false"
        },
        {
          "command": "coordiner.removeWorktree",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "coordiner.continueWorktree",
          "when": "view == coordiner.run && viewItem == worktree-continue",
          "group": "inline@1"
        },
        {
          "command": "coordiner.startHere",
          "when": "view == coordiner.run && viewItem =~ /^worktree/",
          "group": "inline@2"
        },
        {
          "command": "coordiner.openWorktree",
          "when": "view == coordiner.run && viewItem =~ /^worktree/",
          "group": "inline@3"
        },
        {
          "command": "coordiner.removeWorktree",
          "when": "view == coordiner.run && viewItem =~ /^(worktree|gone)/",
          "group": "inline@4"
        },
        {
          "command": "coordiner.continueWorktree",
          "when": "view == coordiner.run && viewItem == worktree-continue",
          "group": "navigation@1"
        },
        {
          "command": "coordiner.startHere",
          "when": "view == coordiner.run && viewItem =~ /^worktree/",
          "group": "navigation@2"
        },
        {
          "command": "coordiner.openWorktree",
          "when": "view == coordiner.run && viewItem =~ /^worktree/",
          "group": "navigation@3"
        },
        {
          "command": "coordiner.removeWorktree",
          "when": "view == coordiner.run && viewItem =~ /^(worktree|gone)/",
          "group": "remove@1"
        },
        {
          "command": "coordiner.stopProcess",
          "when": "view == coordiner.run && viewItem == process",
          "group": "inline"
        },
        {
          "command": "coordiner.stopProcess",
          "when": "view == coordiner.run && viewItem == process",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "coordiner.start",
          "when": "view == coordiner.run",
          "group": "navigation@1"
        },
        {
          "command": "coordiner.openChains",
          "when": "view == coordiner.run",
          "group": "navigation@2"
        },
        {
          "command": "coordiner.stopRun",
          "when": "view == coordiner.run && coordiner.busy",
          "group": "navigation@0"
        }
      ]
    },
    "configuration": {
      "title": "Coordiner",
      "properties": {
        "coordiner.models.strong": {
          "type": "string",
          "default": "claude-opus-5-5",
          "scope": "application",
          "description": "Full model ID for the strong tier (planner Heavy)."
        },
        "coordiner.models.medium": {
          "type": "string",
          "default": "claude-sonnet-5-5",
          "scope": "application",
          "description": "Full model ID for the medium tier (planner Standard)."
        },
        "coordiner.models.weak": {
          "type": "string",
          "default": "claude-haiku-5-5",
          "scope": "application",
          "description": "Full model ID for the weak tier (planner Light)."
        },
        "coordiner.claudePath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Full path to the Claude Code executable sessions run. Empty: the first claude on PATH, else ~/.local/bin/claude, else the one the Claude Code extension bundles."
        },
        "coordiner.extraPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Folder to add to PATH for Claude sessions, e.g. the folder that contains node when the editor was started without it."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "coordiner",
          "title": "Coordiner",
          "icon": "media/coordiner.svg"
        }
      ]
    },
    "views": {
      "coordiner": [
        {
          "id": "coordiner.run",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "coordiner.run",
        "contents": "No sessions yet.\n[Start…](command:coordiner.start)\n[Open Chains](command:coordiner.openChains)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "build": "node build.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-include=media/**/*.js --test-coverage-exclude=src/**/*.test.ts \"src/**/*.test.ts\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.292"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.1",
    "@types/vscode": "1.134.0",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
